# Copy to .env and fill in real values.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Matches the service in docker-compose.yml at the repo root.
POSTGRES_DB=social_media
POSTGRES_USER=social
POSTGRES_PASSWORD=social
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Carries chat delivery between WebSocket connections. Also from docker-compose.
REDIS_URL=redis://localhost:6379/0

# Origins allowed to open a WebSocket; defaults to CORS_ALLOWED_ORIGINS.
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:5173

# Swap to apps.media.storage.cloudinary.CloudinaryStorage for real uploads.
MEDIA_STORAGE_BACKEND=apps.media.storage.local.LocalFileSystemStorage

# Required only when MEDIA_STORAGE_BACKEND is the Cloudinary one.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
